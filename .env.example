# demo = interface local sem autenticação real
# production = autenticação Supabase obrigatória
NEXT_PUBLIC_APP_MODE=demo

# Mantido para Bridge/integração MT5. A v1.2.1 usa o Bridge para conta e sincronização; não exibe gráfico de mercado em tempo real.
MARKET_DATA_PROVIDER=demo

# Obrigatório quando NEXT_PUBLIC_APP_MODE=production
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com projetos Supabase antigos; use apenas se seu projeto ainda expuser anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bridge MT5 local/servidor. O HTTP é usado para conta e histórico/importação.
MT5_BRIDGE_HTTP_URL=http://127.0.0.1:8765
MT5_BRIDGE_SHARED_SECRET=

# WebSocket reservado para evoluções futuras; não é necessário para a UI v1.2.1.
MT5_BRIDGE_WS_URL=ws://127.0.0.1:8765/ws/quotes

# Integração direta com Exness API permanece reservada para evolução futura.
EXNESS_API_BASE_URL=
EXNESS_API_TOKEN=

# URL pública da aplicação usada em callbacks de autenticação.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true = qualquer pessoa pode solicitar cadastro, mas começa como PENDING.
# false = tela de cadastro continua visível, porém não cria novas contas.
REGISTRATION_OPEN=true
